# Comma-separate multiple origins if needed, e.g. for a staging + prod frontend.
CORS_ORIGIN=http://localhost:5173
PORT=4000

# Set by the hosting platform in production (e.g. Render sets this automatically).
# Required when NODE_ENV=production: CORS_ORIGIN must then be set explicitly too,
# the app fails fast at startup rather than silently falling back to localhost.
# NODE_ENV=production
